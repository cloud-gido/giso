# 本地 docker compose 网关（默认；未配 VITE_TRACK_ENDPOINT 时按页面 host 推断 :8123）
# VITE_TRACK_ENDPOINT=http://localhost:8123/v1/track
# VITE_APP_KEY=sports-web-beta

# 测试环境 EKS 网关（复制为 .env.local 后 npm run dev）
# App Key 须在 Doppler INFRA_GISO_APP_KEYS，且前缀 sports-/sport- → 空间 sports
# VITE_TRACK_ENDPOINT=https://gamelinelab-giso.envir.dev/v1/track
# VITE_APP_KEY=sports-web-beta
# VITE_TRACK_DEBUG=true
